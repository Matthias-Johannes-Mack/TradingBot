# Keep this file as a template. Put your own paper keys in .env.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# The SEC asks automated clients for a real contact email in the User-Agent.
GUARDRAIL_CONTACT=
# Set to off to stop the background research sources.
GUARDRAIL_RESEARCH=on
